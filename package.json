{
  "name": "video-creator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx tests/core.test.ts",
    "check": "node --import tsx scripts/cli.ts check",
    "voices": "node --import tsx scripts/cli.ts voices",
    "voice": "node --import tsx scripts/cli.ts voice",
    "prepare": "node --import tsx scripts/cli.ts prepare",
    "dev": "node --import tsx scripts/cli.ts dev",
    "render": "node --import tsx scripts/cli.ts render",
    "deck-audio": "node --import tsx scripts/generate-deck-audio.ts",
    "browser": "remotion browser ensure",
    "setup:lipsync": "node --import tsx scripts/setup-lipsync.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.538",
    "@remotion/cli": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.538",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
